{{ 'cart-page.css' | asset_url | stylesheet_tag }}

{% liquid
  assign form_id = 'CartForm-' | append: section.id
%}

<cart-items
  class="cart-page {{ settings.cart_layout }}{% if settings.cart_sticky_summary %} cart-page--sticky{% endif %}"
  data-section="{{ section.id }}"
  {% if cart.empty? %}
    data-empty
  {% endif %}
>
  {%- if cart.empty? -%}
    <div class="cart-page__empty">
      <h1 class="cart-page__title">{{ 'cart.empty.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="cart-page__empty-link">
        {{- 'cart.continue_shopping' | t -}}
      </a>

      {%- if shop.customer_accounts_enabled and customer == nil -%}
        <p class="cart-page__login">
          {{ 'cart.empty.login_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="cart-page__header">
      <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue">
        {{- 'cart.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart-page__body">
      <form action="{{ routes.cart_url }}" method="post" id="{{ form_id }}" class="cart-page__form" novalidate>
        <div class="cart-page__columns" aria-hidden="true">
          <span>{{ 'cart.columns.product' | t }}</span>
          <span>{{ 'cart.columns.quantity' | t }}</span>
          <span>{{ 'cart.columns.total' | t }}</span>
        </div>

        <ul class="cart-page__items" role="list" data-cart-region="items">
          {%- for item in cart.items -%}
            {% render 'cart-line-item', item: item, index: forloop.index, section_id: section.id %}
          {%- endfor -%}
        </ul>

        <noscript>
          <button type="submit" name="update" class="cart-page__update">{{ 'cart.update' | t }}</button>
        </noscript>
      </form>

      <div class="cart-page__footer">
        {% render 'cart-summary', form_id: form_id, show_express: true %}
      </div>
    </div>
  {%- endif -%}
</cart-items>

<p
  id="CartStatus-{{ section.id }}"
  class="visually-hidden"
  role="status"
  data-message="{{ 'cart.status_updated' | t }}"
></p>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
